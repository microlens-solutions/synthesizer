<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>Microlens</Authors>
		<Copyright>Copyright © $([System.DateTime]::Now.Year) Microlens</Copyright>
		<Description>Roslyn semantic-model library that generates compilable Bogus Faker&lt;T&gt; source from C# classes and record classes, covering inherited properties, generic types, enums, arrays, lists, hash sets, dictionaries and convention-based string values, extensible through custom type providers.</Description>

		<TargetFramework>netstandard2.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>7.3</LangVersion>

		<RootNamespace>Microlens.Synthesizer.Core</RootNamespace>
		<AssemblyName>Microlens.Synthesizer.Core</AssemblyName>

		<PackageId>Microlens.Synthesizer.Core</PackageId>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>bogus;faker;fake-data;test-data;unit-testing;roslyn;semantic-model;code-generation;scaffolding;boilerplate;csharp</PackageTags>
		<PackageProjectUrl>https://github.com/microlens-solutions/synthesizer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/microlens-solutions/synthesizer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
	</ItemGroup>

</Project>
